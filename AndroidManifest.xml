<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen for the Fire TV. Internet is used only for Open-Meteo weather (city coordinates),
     the show pictures the streaming apps link to for Continue watching, one YouTube search
     (the video's title and channel) per YouTube video, to find its picture and link, and, when no
     city is set, one OpenStreetMap lookup of the TV's postcode and country. -->
<!-- READ_LOGS and READ_TV_LISTINGS are granted once over adb (see tv.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.tvhome"
    android:versionCode="69"
    android:versionName="3.44">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="30" />

    <!-- Sees the Home press line in the system activity log. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- Reads the TV's shared "Watch Next" list for the Continue watching row. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Control panel: Wi-Fi status, and screen brightness (WRITE_SETTINGS is granted once over adb, see tv.sh). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Control panel: ADB on/off (granted once over adb, see tv.sh) and closing background apps. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Android shares the Wi-Fi network's name only with location access; used for nothing else. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11 hides other apps unless they are named here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="amazon.intent.action.MAINSETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <package android:name="com.android.providers.tv" />
        <!-- Fire TV's Settings app: the control panel opens its pages directly. -->
        <package android:name="com.amazon.tv.settings.v2" />
        <!-- Android's "start screensaver now" screen. -->
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@style/HomeTheme">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Reads the TV's "now playing" reports for Continue watching (YouTube). Needs notification
             access, granted over adb; it never reads notifications themselves. -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:label="@string/media_watcher_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".HomeTakeoverService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/takeover_service" />
        </service>
    </application>
</manifest>
